# CyberVigil Environment Configuration Template
# Copy this file to .env and configure your keys:

# --- AI Intelligence (Google Gemini) ---
# Obtain your API key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3.6-flash

# --- Optional: Supabase Production Backend ---
# If omitted or unconfigured, CyberVigil automatically runs with its built-in local persistence engine.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Optional: Discord Security Incident Webhook ---
# If omitted, incident alerts are safely logged in the local defender console.
# VITE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
